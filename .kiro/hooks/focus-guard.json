{
  "version": "v1",
  "hooks": [
    {
      "name": "focus-guard",
      "trigger": "PreToolUse",
      "description": "Blocks writes that remove the keyboard focus outline in src/",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "node .kiro/scripts/focus-guard.mjs",
        "timeout": 20
      }
    }
  ]
}